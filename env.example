# 智诊通多模态向量化服务环境配置

# 服务配置
SERVICE_NAME=zhi-zhen-tong-embedding
SERVICE_VERSION=1.0.0
LOG_LEVEL=INFO
DEBUG=false

# 端口配置
API_PORT=8000
ADMIN_PORT=8001
REDIS_PORT=6379
CHROMADB_PORT=8002

# 数据库配置
REDIS_URL=redis://redis:6379/0
CHROMADB_URL=http://chromadb:8000

# 模型配置
TEXT_MODEL_PATH=/app/models/BiomedCLIP-PubMedBERT_256-vit_base_patch16_224
EMBEDDING_MODEL=nghuyong/ernie-3.0-base-zh
MAX_SEQUENCE_LENGTH=512

# 数据路径配置
DATA_ROOT_PATH=/app/datas
LOG_PATH=/app/logs
VECTOR_DB_PATH=/app/datas/chroma_db/multimodal

# 缓存配置
CACHE_TTL=3600
MAX_CACHE_SIZE=1000

# 安全配置
SECRET_KEY=your-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# 性能配置
MAX_WORKERS=4
WORKER_TIMEOUT=300
REQUEST_TIMEOUT=60

# 监控配置
ENABLE_METRICS=true
METRICS_PORT=9090

# 开发配置
RELOAD=false
HOT_RELOAD=false
