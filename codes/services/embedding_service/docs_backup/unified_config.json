{
  "version": "1.0.0",
  "description": "向量化服务统一配置文件",
  "models": {
    "text_embedding": {
      "model_name": "BiomedCLIP-PubMedBERT_256-vit_base_patch16_224",
      "model_path": "../../aimodels/BiomedCLIP-PubMedBERT_256-vit_base_patch16_224",
      "max_length": 512,
      "batch_size": 32,
      "vector_dim": 512
    },
    "image_embedding": {
      "model_name": "BiomedCLIP-PubMedBERT_256-vit_base_patch16_224",
      "model_path": "../../aimodels/BiomedCLIP-PubMedBERT_256-vit_base_patch16_224",
      "image_size": 224,
      "batch_size": 16,
      "vector_dim": 512
    },
    "quality_analysis": {
      "semantic_model": {
        "model_name": "paraphrase-multilingual-MiniLM-L12-v2",
        "model_path": "../../aimodels/quality_analysis_models/paraphrase-multilingual-MiniLM-L12-v2",
        "vector_dim": 384,
        "description": "语义相似度计算模型"
      },
      "classifier_model": {
        "model_name": "distilbert-base-multilingual-cased",
        "model_path": "../../aimodels/quality_analysis_models/distilbert-base-multilingual-cased",
        "description": "文本分类和质量评估模型"
      }
    }
  },
  "data": {
    "base_dir": "../../../datas/medical_knowledge",
    "text_data": {
      "raw_dir": "text_data/raw",
      "processed_dir": "text_data/processed"
    },
    "image_text_data": {
      "raw_dir": "image_text_data/raw",
      "processed_dir": "image_text_data/processed"
    },
    "voice_data": {
      "raw_dir": "voice_data/raw",
      "processed_dir": "voice_data/processed"
    },
    "training_data": "training_data",
    "test_data": "test_data",
    "logs": "logs"
  },
  "processing": {
    "text": {
      "max_length": 512,
      "batch_size": 32,
      "preprocessing": {
        "remove_special_chars": true,
        "normalize_whitespace": true,
        "remove_duplicates": true
      }
    },
    "image": {
      "resize": [
        224,
        224
      ],
      "normalize": true,
      "batch_size": 16,
      "supported_formats": [
        "jpg",
        "jpeg",
        "png",
        "bmp"
      ]
    }
  },
  "vector_database": {
    "type": "chroma",
    "collection_name": "medical_multimodal_vectors",
    "persist_directory": "../../datas/chroma_db",
    "distance_metric": "cosine"
  },
  "logging": {
    "level": "INFO",
    "file": "logs/vectorization.log",
    "max_size": "10MB",
    "backup_count": 5
  },
  "quality_analyzer": {
    "min_length": 10,
    "max_length_ratio": 1.2,
    "model_max_tokens": 512,
    "semantic_similarity_threshold": 0.95,
    "batch_size": 32,
    "irrelevant_keywords": ["金融", "游戏", "娱乐", "体育", "政治", "军事", "科技"],
    "special_char_ratio_threshold": 0.3,
    "medical_keywords": ["疾病", "症状", "治疗", "诊断", "药物", "医院", "医生", "患者", "健康", "医疗"],
    "encoding": "utf-8",
    "token_overhead": 10,
    "semantic_model_name": "paraphrase-multilingual-MiniLM-L12-v2",
    "classifier_model_name": "distilbert-base-multilingual-cased",
    "embedding_model_name": "microsoft/BiomedCLIP-PubMedBERT_256-vit_base_patch16_224"
  }
}