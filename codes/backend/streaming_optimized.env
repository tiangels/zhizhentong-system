# 流式输出性能优化配置
# 针对不同场景的优化配置

# 流式输出模式
STREAMING_MODE=real

# 高性能配置（推荐用于生产环境）
REAL_STREAMING_ENABLED=true
REAL_STREAMING_CHUNK_SIZE=1
REAL_STREAMING_DELAY_MS=0
REAL_STREAMING_TIMEOUT=60.0

# 连接池配置
MAX_CONNECTIONS=100
CONNECTION_TIMEOUT=30
KEEP_ALIVE_TIMEOUT=60

# 缓存配置
CACHE_ENABLED=true
CACHE_TTL=300
CACHE_MAX_SIZE=1000

# 压缩配置
COMPRESSION_ENABLED=true
COMPRESSION_LEVEL=6
COMPRESSION_THRESHOLD=1024

# 批处理配置
BATCH_SIZE=1
BATCH_TIMEOUT=0
BATCH_FLUSH_INTERVAL=0

# 监控配置
METRICS_ENABLED=true
METRICS_INTERVAL=10
PERFORMANCE_MONITORING=true

# 日志配置
STREAMING_LOG_LEVEL=INFO
STREAMING_DEBUG=false
LOG_FORMAT=json
LOG_ROTATION=true

# 检索服务配置
RETRIEVAL_SERVICE_URL=http://localhost:8001
RETRIEVAL_STREAMING_ENABLED=true
RETRIEVAL_TIMEOUT=30.0
RETRIEVAL_RETRY_COUNT=3
RETRIEVAL_RETRY_DELAY=1.0

# 负载均衡配置
LOAD_BALANCING_ENABLED=false
HEALTH_CHECK_INTERVAL=30
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_THRESHOLD=5

# 安全配置
RATE_LIMITING_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
CORS_ENABLED=true
CORS_ORIGINS=*

# 性能调优
WORKER_PROCESSES=4
WORKER_THREADS=8
MAX_REQUEST_SIZE=10485760
KEEP_ALIVE_REQUESTS=1000
